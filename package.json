{
  "name": "boxuegu-video-player",
  "version": "1.0.1",
  "description": "博学谷视频播放客户端 - 支持缓存、字幕提取、大模型解读",
  "main": "main.js",
  "author": {
    "name": "Samge0",
    "email": "samge@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "setup-whisper": "python -m venv .whisper-venv && .whisper-venv/Scripts/pip install faster-whisper nvidia-cublas-cu12 && node scripts/fix-cuda-dlls.js"
  },
  "build": {
    "appId": "com.boxuegu.videoplayer",
    "productName": "博学谷视频播放器",
    "artifactName": "BoxueguVideoPlayer-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/.git/*",
      "!**/node_modules/*/{test,tests,__tests__}/**",
      "!dist/**",
      "!.whisper-venv/**",
      "!*.js.orig"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "maintainer": "Samge <samge@users.noreply.github.com>",
      "category": "Education",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  }
}
