{
  "name": "boxuegu-video-player",
  "version": "1.0.0",
  "description": "博学谷视频播放客户端 - 支持缓存、字幕提取、大模型解读",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build-portable": "electron-builder --win portable",
    "setup-whisper": "python -m venv .whisper-venv && .whisper-venv/Scripts/pip install faster-whisper nvidia-cublas-cu12 && node scripts/fix-cuda-dlls.js",
    "postinstall": "node scripts/check-whisper-venv.js || echo \"Run npm run setup-whisper to enable GPU subtitle extraction\""
  },
  "build": {
    "appId": "com.boxuegu.videoplayer",
    "productName": "博学谷视频播放器",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "**/*",
      "!**/.git/*",
      "!**/node_modules/*/{test,tests,__tests__}/**",
      "!cache/**",
      "!*.js.orig"
    ]
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^25.0.0"
  }
}
